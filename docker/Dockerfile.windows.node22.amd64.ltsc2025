# escape=`

ARG RUNTIME_IMAGE=harness/node-build-nano@sha256:1c2de59b2bdf996199fb56a302f681bf6708f8ac1eba828bdc49eb28c061584b
FROM ${RUNTIME_IMAGE}
USER ContainerAdministrator
SHELL ["C:\\PowerShell\\pwsh.exe", "-NoLogo", "-NonInteractive", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

RUN New-Item -ItemType Directory -Force C:/bin,C:/temp,C:/uploads,C:/users/ContainerAdministrator/.jfrog/security/certs | Out-Null; `
    Invoke-WebRequest -UseBasicParsing -Uri 'https://releases.jfrog.io/artifactory/jfrog-cli/v2/2.115.0/jfrog-cli-windows-amd64/jfrog.exe' -OutFile 'C:/bin/jfrog.exe'; `
    if ((Get-FileHash -Algorithm SHA256 'C:/bin/jfrog.exe').Hash.ToLowerInvariant() -ne 'c3997e333dd1d70defe77783dc5ee7fcb5bd537ecb45e57e8b3fb6e2efa41d6c') { throw 'JFrog CLI SHA-256 mismatch' }; `
    Copy-Item -LiteralPath C:/bin/jfrog.exe -Destination C:/bin/jf.exe -Force
COPY release/windows/amd64/plugin C:/bin/drone-artifactory.exe

ENV CI=true `
    GODEBUG=netdns=go `
    PATH="C:\\bin;${PATH}"

LABEL org.opencontainers.image.source="https://github.com/drone-plugins/drone-artifactory" `
      org.opencontainers.image.revision="b2e6706dd0475eec3ab373716a6041002c3404d0" `
      org.opencontainers.image.version="1.10.0-rc.1" `
      io.harness.node.version="22.23.2" `
      io.harness.windows.build="26100" `
      io.harness.release.status="candidate"

ENTRYPOINT ["C:\\bin\\drone-artifactory.exe"]
